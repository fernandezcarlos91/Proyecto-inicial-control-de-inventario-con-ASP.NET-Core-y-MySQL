@model InventarioWeb.Models.Categoria

@{
    ViewData["Title"] = "Eliminar categoría";
}

<h1 class="h3 mb-4">Eliminar categoría</h1>

<div class="card p-4 col-md-6">
    <p>¿Confirmas que quieres eliminar la categoría <strong>@Model.Nombre</strong>?</p>

    @if (Model.Productos.Any())
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            Esta categoría tiene <strong>@Model.Productos.Count</strong> producto(s) asociado(s).
            Reasígnalos a otra categoría o elimínalos antes de poder borrar esta.
        </div>
    }

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-danger" @(Model.Productos.Any() ? "disabled" : "")>
            <i class="bi bi-trash me-1"></i> Eliminar definitivamente
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</div>
