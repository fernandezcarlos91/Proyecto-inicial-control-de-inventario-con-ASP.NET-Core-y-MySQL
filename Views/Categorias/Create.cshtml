@model InventarioWeb.Models.Categoria

@{
    ViewData["Title"] = "Nueva categoría";
}

<h1 class="h3 mb-4">Nueva categoría</h1>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <input asp-for="Nombre" class="form-control" placeholder="Ej: Periféricos" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Descripción</label>
        <textarea asp-for="Descripcion" class="form-control" rows="3"
                  placeholder="Ej: Mouse, teclados, audífonos y accesorios"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">
        <i class="bi bi-check-lg me-1"></i> Guardar
    </button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>
